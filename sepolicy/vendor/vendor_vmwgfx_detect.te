type vendor_vmwgfx_detect, domain;
type vendor_vmwgfx_detect_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_vmwgfx_detect);

set_prop(vendor_vmwgfx_detect, vendor_graphics_prop)

allow vendor_vmwgfx_detect gpu_device:dir r_dir_perms;
allow vendor_vmwgfx_detect gpu_device:chr_file { getattr ioctl map open read write };
