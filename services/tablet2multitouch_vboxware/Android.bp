cc_defaults {
    name: "tablet2multitouch_vboxware_defaults",
    srcs: [
        "tablet2multitouch_vboxware.cpp",
    ],
    shared_libs: [
        "libbase",
        "//hardware/mainline/common:libtablet2multitouch",
    ],
}

cc_binary {
    name: "tablet2multitouch_vboxware",
    defaults: ["tablet2multitouch_vboxware_defaults"],
    init_rc: ["tablet2multitouch_vboxware.rc"],
    vendor: true,
}

cc_binary {
    name: "tablet2multitouch_vboxware_recovery",
    stem: "tablet2multitouch_vboxware",
    defaults: ["tablet2multitouch_vboxware_defaults"],
    init_rc: ["tablet2multitouch_vboxware.recovery.rc"],
    recovery: true,
}
